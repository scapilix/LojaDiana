# Binance API (deixe vazio para usar apenas paper trading)
# Cria as chaves em https://www.binance.com/en/my/settings/api-management
# Ativa APENAS a permissão "Spot & Margin Trading" — nunca ative "Withdrawals" (saques)
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=false

# Configurações de trading
PAPER_BALANCE=10000
REAL_TRADING=false
AUTO_TRADE=false
MIN_CONFIDENCE=70
